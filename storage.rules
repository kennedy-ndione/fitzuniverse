rules_version = '2';

// ============================================================
// Fitz - Règles de sécurité Storage
//
// Jusqu'au lot E1 (2026-09-07), aucune fonctionnalité du site
// n'écrivait ici. Désormais UN usage, borné :
//
//   users/{uid}/applications/{applicationId}/preuve-depot.<ext>
//     la capture de confirmation d'un dépôt (js/preuve-depot.js,
//     mode "capture" ou "transmis"). Lecture et écriture réservées au
//     PROPRIÉTAIRE ; image ou PDF ; 5 Mo au plus (une capture d'écran
//     pèse quelques centaines de Ko, un PDF de confirmation rarement
//     plus d'un Mo — la compression client vise 1,5 Mo, 5 Mo est le
//     plafond serveur). Un administrateur ne lit PAS la capture : il
//     voit la déclaration (mode, numéro, date) dans le CRM, ce qui
//     suffit à la statistique. Aucune capture n'est jamais lisible
//     par un autre étudiant, ni exposée dans l'export du catalogue
//     (scripts/lot.mjs ne lit que le catalogue).
//
// Le reste du dossier users/{uid}/ n'est plus ouvert en écriture
// « pour un futur usage » : tout nouvel usage écrira sa propre règle.
// ============================================================

service firebase.storage {
match /b/{bucket}/o {

function estProprietaire(uid) {
return request.auth != null && request.auth.uid == uid;
}

// AUDIT 2026-10 : une session ANONYME (lecture de Fitz sur la page de
// résultats) n'a ni profil ni candidature. Elle n'écrit rien ici : sans
// cela, chaque session anonyme ouvrait un dossier de 5 Mo par fichier,
// sans limite de nombre.
function estCompteReel() {
return request.auth.token.firebase.sign_in_provider != 'anonymous';
}

// L'image SVG est refusée, quelle que soit la casse du type (un
// navigateur lit « image/SVG+xml » comme du SVG) : c'est un document actif
// (scripts), jamais une capture d'écran. Le client compresse toute image
// en JPEG avant l'envoi (applications.js, espace-preinscription.js).
function estCaptureAcceptable() {
return request.resource != null &&
request.resource.size <= 5 * 1024 * 1024 &&
((request.resource.contentType.matches('image/.*') && !request.resource.contentType.lower().matches('image/svg.*')) || request.resource.contentType == 'application/pdf');
}

// AUDIT 2026-10 : UN fichier par candidature, au nom que donne
// cheminCapture (js/preuve-depot.js) — « preuve-depot.<ext> ». Un nouvel
// envoi remplace l'ancien au lieu de s'ajouter. La suppression a sa
// propre règle : la propriété « method » de la requête n'existe pas dans les règles
// Storage (l'émulateur le signalait à chaque écriture).
match /users/{uid}/applications/{applicationId}/{fichier} {
allow read: if estProprietaire(uid);
allow create, update: if estProprietaire(uid) && estCompteReel() && fichier.matches('preuve-depot[.][a-z0-9]{1,5}') && estCaptureAcceptable();
allow delete: if estProprietaire(uid);
}

match /users/{uid}/{allPaths=**} {
allow read: if estProprietaire(uid);
allow write: if false;
}

match /{allPaths=**} {
allow read, write: if false;
}

}
}

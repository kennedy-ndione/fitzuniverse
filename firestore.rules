rules_version = '2';

// ============================================================
// Fitz - Règles de sécurité Firestore
//
// Contexte : le panneau d'administration (admin/) ne vérifie
// aujourd'hui l'appartenance "admin" que côté client (existence
// d'un document admins/{uid}). Sans règles serveur, n'importe quel
// compte étudiant authentifié pourrait s'auto-promouvoir admin ou
// écraser le catalogue de bourses/universités. Ces règles déplacent
// le vrai contrôle d'accès ici, côté serveur :
//
//  - la collection "admins" n'est JAMAIS modifiable par un client
//    (uniquement via la console Firebase ou un futur Cloud Function
//    utilisant l'Admin SDK) ;
//  - seuls les comptes possédant un document admins/{uid} actif
//    peuvent écrire dans "universities"/"scholarships" ;
//  - chaque utilisateur garde l'entière propriété de son propre
//    document dans "users" (sauf "plan"/"disabled"/"testerAccess") et
//    peut le supprimer définitivement ; un administrateur peut lire
//    n'importe quel document (CRM étudiants) mais ne peut en écrire
//    que ces trois champs réservés, jamais le reste (profil, nom,
//    email...).
// ============================================================

service cloud.firestore {
match /databases/{database}/documents {

function isSignedIn() {
return request.auth != null;
}

function isOwner(uid) {
return isSignedIn() && request.auth.uid == uid;
}

function isAdmin() {
return isSignedIn() &&
exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.isActive == true;
}

// ------------------------------------------------------------
// DEUX NIVEAUX D'ADMINISTRATEUR (lot ADMIN, 2026-09-09)
//
//   superAdmin  le propriétaire : nomme, révoque, et pose une formule
//               à la main.
//   admin       un collègue : gère les étudiants, les messages, le
//               catalogue. Ne nomme personne, ne révoque personne, ne
//               se promeut pas, n'attribue aucune formule.
//
// RÈGLE D'AMORÇAGE, DÉLIBÉRÉE : un document `admins` ACTIF et SANS
// champ `role` vaut superAdmin. Les comptes qui existaient avant ce lot
// sont donc propriétaires d'office, et l'interface fonctionne dès le
// déploiement — aucune écriture manuelle en console n'est nécessaire.
//
// Ce n'est pas une faille, et la raison tient en une phrase : AUCUN
// client ne peut créer un document `admins` sans être déjà superAdmin,
// et cette création force role:"admin". Un document sans rôle ne peut
// donc naître que dans la console Firebase, c'est-à-dire de la main du
// propriétaire du projet.
// ⚠️ DEUX GRAPHIES, ET LA SECONDE EST CELLE DE LA PRODUCTION.
// Le document du propriétaire, créé en console bien avant ce lot, porte
// `role: "super-admin"` — avec un trait d'union. La première version de
// cette fonction ne reconnaissait que "superAdmin" : elle a donc traité
// le PROPRIÉTAIRE comme un administrateur ordinaire, ce qui lui a retiré
// d'un coup le droit d'écrire `plan` et de nommer qui que ce soit, et a
// cassé la fiche étudiant côté navigateur (correctif du 2026-09-09).
//
// La leçon vaut d'être écrite : la règle d'amorçage supposait « aucun
// champ role ». Le document réel EN AVAIT UN, orthographié autrement.
// On accepte donc les deux graphies. "superAdmin" reste la forme
// canonique, celle que le code écrit ; "super-admin" est acceptée parce
// qu'elle EXISTE, et qu'une règle qui ignore l'état réel de la base est
// une règle fausse, si élégante soit-elle.
function estSuperAdminDoc(d) {
return d.isActive == true && (!d.keys().hasAny(["role"]) || d.role == "superAdmin" || d.role == "super-admin");
}

function isSuperAdmin() {
return isSignedIn() &&
exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
estSuperAdminDoc(get(/databases/$(database)/documents/admins/$(request.auth.uid)).data);
}

// Les champs d'ENTITLEMENT : ce qui donne accès à un produit payant.
// Seul un superAdmin les pose à la main, et toute pose laisse une trace
// (`attributionManuelle`, écrite dans la même requête).
function champsFormule() {
return ["plan", "planExpiresAt", "planPreinscription", "planPreinscriptionExpiresAt", "fitzExpressExpiresAt", "attributionManuelle"];
}

// Ce qu'un administrateur ORDINAIRE peut changer sur un compte : de la
// modération, jamais un droit payant.
function champsAdminOrdinaire() {
return ["disabled", "testerAccess"];
}

// ------------------------------------------------------------
// AUDIT SÉCURITÉ 2026-09-02 — le serveur connaît les formules.
// Jusqu'ici, le quota de candidatures et les fonctionnalités payantes
// n'étaient vérifiés QUE côté client (js/plan-features.js) : un
// étudiant outillé pouvait, depuis la console développeur, créer des
// candidatures sans limite, répondre à la messagerie en formule
// Gratuit ou déposer des demandes conseiller sans Signature. Les
// helpers ci-dessous lisent la formule du COMPTE (users/{uid}.plan,
// qu'aucun étudiant ne peut s'attribuer — voir la règle users) et
// portent ici le plancher de chaque droit. Le client reste plus
// restrictif (expiration planExpiresAt, bascules config/planFeatures) ;
// ces règles sont le PLANCHER infranchissable, pas le miroir exact.
//
// Les quotas dupliquent volontairement pricing-plans.js
// (maxAccompaniedApplications) : les règles ne peuvent pas lire un
// fichier JS. Toute modification de la grille DOIT être répercutée ici.
// ------------------------------------------------------------

function planOf(uid) {
return get(/databases/$(database)/documents/users/$(uid)).data.get('plan', '');
}

function isTester(uid) {
return get(/databases/$(database)/documents/users/$(uid)).data.get('testerAccess', false) == true;
}

// GRILLE A (2026-09-07) : `essentiel-4` et `conseiller-6` AJOUTÉS ;
// aucun ancien identifiant retiré — ce sont les valeurs de `plan` des
// comptes existants, et leurs droits d'origine sont conservés.
function isPaidPlan(uid) {
return planOf(uid) in ['premier-dossier', 'essentiel', 'essentiel-4', 'accompagnement', 'premium', 'signature-focus', 'conseiller-6', 'signature'];
}

function isSignaturePlan(uid) {
return planOf(uid) in ['signature-focus', 'conseiller-6', 'signature'];
}

// MESSAGERIE (grille A) — le droit de RÉPONDRE côté bourses. Réservée
// au Forfait Conseiller (conseiller-6) pour les offres en vente ;
// essentiel, accompagnement, premium, signature-focus et signature la
// CONSERVENT (règle d'or : aucun détenteur ne perd un droit acquis).
// premier-dossier et essentiel-4 en sont exclus ; ils ont le service
// après-vente (supportTickets, plus bas).
function isMessagingPlan(uid) {
return planOf(uid) in ['essentiel', 'accompagnement', 'premium', 'signature-focus', 'conseiller-6', 'signature'];
}

// Un Pass Découverte a existé sur ce compte. Les règles ne savent pas
// comparer une chaîne ISO à request.time : l'expiration reste vérifiée
// côté client (même limite acceptée que planExpiresAt). Sert
// uniquement au service après-vente.
function hasFitzExpressPass(uid) {
return get(/databases/$(database)/documents/users/$(uid)).data.get('fitzExpressExpiresAt', '') != '';
}

// Quota de candidatures SIMULTANÉES par formule, exprimé en MOTIF
// D'IDENTIFIANT autorisé — miroir de maxAccompaniedApplications
// (pricing-plans.js) : premier-dossier 1, essentiel-4 4, essentiel 5,
// conseiller-6 6, accompagnement 9, premium/signature-focus 12, signature illimitée
// (999 créneaux — fini pour rester exprimable, inatteignable en
// pratique), gratuit 0. Un motif plutôt qu'un nombre : matches() est
// la construction la plus sûre du langage des règles, sans conversion
// de chaîne. La chaîne vide pour "gratuit" ne matche aucun id réel
// (un id de document n'est jamais vide) : création impossible.
// get() est mis en cache par requête : les appels répétés à planOf()
// ne coûtent qu'UNE lecture.
// Grille A (2026-09-07) : essentiel-4 → 4 créneaux, conseiller-6 → 6.
// Les anciens motifs sont conservés tels quels.
function slotPattern(uid) {
return isTester(uid) ? 'slot-([1-9][0-9]{0,2})' :
(planOf(uid) == 'signature' ? 'slot-([1-9][0-9]{0,2})' :
(planOf(uid) == 'signature-focus' ? 'slot-([1-9]|1[0-2])' :
(planOf(uid) == 'premium' ? 'slot-([1-9]|1[0-2])' :
(planOf(uid) == 'accompagnement' ? 'slot-[1-9]' :
(planOf(uid) == 'conseiller-6' ? 'slot-[1-6]' :
(planOf(uid) == 'essentiel' ? 'slot-[1-5]' :
(planOf(uid) == 'essentiel-4' ? 'slot-[1-4]' :
(planOf(uid) == 'premier-dossier' ? 'slot-1' : ''))))))));
}

// ------------------------------------------------------------
// GRILLE B (2026-09-07) — le second forfait, PRÉINSCRIPTION.
// users/{uid}.planPreinscription est écrit par le webhook seul (mêmes
// protections que "plan"). Les droits sont l'UNION des deux forfaits :
// un compte Dossier France peut répondre à la messagerie même sans
// formule bourse ; seul Dossier France + Conseiller ouvre la revue
// conseiller. L'expiration (planPreinscriptionExpiresAt) reste vérifiée
// côté client — même limite acceptée que planExpiresAt.
// ------------------------------------------------------------
function planPreOf(uid) {
return get(/databases/$(database)/documents/users/$(uid)).data.get('planPreinscription', '');
}

function isDossierFrance(uid) {
return planPreOf(uid) in ['dossier-france', 'dossier-france-conseiller'];
}

function isDossierConseiller(uid) {
return planPreOf(uid) == 'dossier-france-conseiller';
}

// Grille A : les TROIS offres préinscription ouvrent la messagerie
// (Diagnostic France compris) et le service après-vente.
function hasPreinscription(uid) {
return planPreOf(uid) in ['diagnostic-france', 'dossier-france', 'dossier-france-conseiller'];
}

// Quota PRÉINSCRIPTION : les 7 vœux d'un dossier Études en France —
// miroir de maxPreinscriptions (pricing-plans.js). Les candidatures de
// ce parcours s'appellent "pre-N" : un espace d'identifiants DISTINCT
// de "slot-N", donc un quota qui ne consomme jamais l'autre. Le client
// (slotIdLibre, js/application-actions.js) suit le même préfixe.
function preSlotPattern(uid) {
return (isTester(uid) || isDossierFrance(uid)) ? 'pre-[1-7]' : '';
}

// ------------------------------------------------------------
// Profils utilisateurs (créés à l'inscription, lus/modifiés
// depuis dashboard.js et profile.js). Depuis le Module 3 du Control
// Center (CRM étudiants, admin/student-detail.js), un administrateur
// peut aussi LIRE n'importe quel profil, et ÉCRIRE uniquement les
// champs qu'il gère lui-même ("plan" = formule choisie, "disabled" =
// suspension de compte) — jamais le reste du document (profile, name,
// email...), qui reste la propriété exclusive de l'étudiant.
//
// SÉCURITÉ (corrigé lors de l'audit auth/abonnements) : "plan",
// "disabled" et "testerAccess" sont désormais réservés à
// l'administrateur DANS LES DEUX SENS — le propriétaire peut modifier
// tout son document SAUF ces champs. Avant ce correctif, isOwner(uid)
// autorisait une écriture sans restriction de champ : un étudiant
// connecté pouvait s'auto-attribuer n'importe quelle formule (y compris
// "premium") directement depuis la console développeur, sans jamais
// passer par l'interface ni par un paiement. affectedKeys() garantit
// qu'aucune écriture (admin ou propriétaire) ne peut toucher un champ
// hors de son périmètre autorisé.
//
// "testerAccess" (booléen) : accès complet à toutes les formules pour
// un compte précis, réservé aux tests internes avant lancement — voir
// js/access-guard.js. Seul un administrateur peut le poser, jamais
// l'étudiant lui-même : mêmes règles que "plan"/"disabled".
//
// allow delete : un étudiant peut désormais supprimer définitivement
// son propre compte (js/account-actions.js, account.html) — jamais un
// administrateur ni un autre utilisateur.
// ------------------------------------------------------------
// planExpiresAt/fitzExpressExpiresAt (ajoutés 2026-07-30, pricing
// pivot) suivent exactement la même règle que "plan" : seul un
// administrateur peut les poser — sinon un étudiant pourrait
// s'auto-prolonger un abonnement expiré, ou s'accorder un Pass Fitz
// Express gratuitement. Le futur backend de paiement, une fois
// construit, agira avec des privilèges admin (Cloud Function), pas
// avec le compte de l'étudiant.
// allow create : même liste de champs interdits qu'à la mise à jour
// (2026-08-07, retrait de l'inscription libre). Avant ce correctif,
// isOwner(uid) suffisait SEUL à la création, sans restriction de
// champ — le trou décrit plus haut pour "update" existait de façon
// identique à la création : un visiteur pouvait s'inscrire (Auth) puis
// écrire lui-même n'importe quel `plan` dans le tout premier
// setDoc(), avant même qu'une règle "update" n'entre en jeu. Le
// compte se crée désormais uniquement depuis payment.js
// (ensureAccount()), qui n'écrit jamais "plan" — seul "pendingPlan"
// (hors de cette liste, informatif, sans effet sur l'accès).
match /users/{uid} {
allow read: if isOwner(uid) || isAdmin();
// LOT ADMIN (2026-09-09) : la grille PRÉINSCRIPTION s'ouvre à
// l'attribution manuelle, ce qu'elle refusait jusqu'ici. L'intention
// d'origine — éviter qu'une régularisation à la main diverge d'un vrai
// paiement — était bonne, mais elle ne protégeait rien : le MÊME risque
// existait déjà, à l'identique, sur `plan`, que l'admin écrivait
// librement. L'asymétrie interdisait seulement de tester la moitié du
// produit. On ouvre les deux grilles, on réserve les deux au
// superAdmin, et on rend la trace explicite des deux côtés
// (`attributionManuelle`).
allow create: if isOwner(uid) && !request.resource.data.keys().hasAny(champsFormule().concat(["disabled", "testerAccess"]));
allow update: if
// Le superAdmin : les droits payants, et rien d'autre.
(isSuperAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(champsFormule().concat(champsAdminOrdinaire()))) ||
// L'administrateur ordinaire : de la modération seulement.
(isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(champsAdminOrdinaire())) ||
// L'étudiant : tout SAUF ces champs — `attributionManuelle` comprise,
// sans quoi il pourrait effacer la trace de sa propre régularisation.
(isOwner(uid) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(champsFormule().concat(["disabled", "testerAccess"])));
allow delete: if isOwner(uid);
}

// ------------------------------------------------------------
// Notes internes admin sur un étudiant (Module 3) : jamais visibles
// ni modifiables par l'étudiant lui-même, append-only (pas de
// modification/suppression, pour garder un historique fiable).
// ------------------------------------------------------------
match /users/{uid}/adminNotes/{noteId} {
allow read, create: if isAdmin();
allow update, delete: if false;
}

// ------------------------------------------------------------
// Messages envoyés par un administrateur à un étudiant (Module 3).
// L'étudiant peut les lire et marquer "lu" (mise à jour du seul champ
// "read"), mais jamais en créer lui-même. Suppression : réservée au
// propriétaire, pour lui permettre de vider sa propre messagerie lors
// de la suppression de son compte (account.html) — un administrateur
// ne peut toujours pas supprimer les messages qu'il a envoyés.
// ------------------------------------------------------------
match /users/{uid}/messages/{messageId} {
// Messagerie FitzUniverse bidirectionnelle (2026-09-02) : l'étudiant
// peut RÉPONDRE dans son propre fil, avec une forme imposée
// (fromStudent:true, read:false, texte non vide) — il ne peut ni
// usurper un message "FitzUniverse" ni pré-marquer lu.
// AUDIT SÉCURITÉ (même jour) : le droit de répondre est fermé au
// plan Gratuit — désormais aussi ICI (isPaidPlan/isTester), plus
// seulement côté client : un compte gratuit ne peut plus écrire
// dans le fil depuis la console développeur.
// GRILLE A (2026-09-07) : resserré — isMessagingPlan (côté bourses,
// Conseiller + détenteurs des anciennes formules) ou une offre
// préinscription (les trois). Voir js/plan-features.js.
allow create: if isAdmin() ||
(isOwner(uid) &&
(isMessagingPlan(uid) || hasPreinscription(uid) || isTester(uid)) &&
request.resource.data.keys().hasOnly(["text", "fromStudent", "createdAt", "read"]) &&
request.resource.data.text is string && request.resource.data.text != "" &&
request.resource.data.fromStudent == true &&
request.resource.data.read == false);
allow read: if isOwner(uid) || isAdmin();
// L'admin doit pouvoir marquer LUES les réponses étudiantes depuis
// le centre de messages — même clé unique "read" que côté étudiant.
allow update: if (isOwner(uid) || isAdmin()) &&
request.resource.data.diff(resource.data).affectedKeys().hasOnly(["read"]);
allow delete: if isOwner(uid);
}

// ------------------------------------------------------------
// Demandes de revue conseiller (Signature / Signature Focus) —
// contrepartie étudiant -> admin de users/{uid}/messages ci-dessus
// (qui va admin -> étudiant), donc les mêmes règles mais inversées.
// L'étudiant crée sa demande (texte + candidature concernée
// optionnelle), toujours avec status "nouveau" imposé à la création
// pour qu'il ne puisse pas se marquer lui-même "traité" ; seul un
// administrateur peut ensuite faire évoluer ce statut (voir
// admin/student-detail.js). Suppression réservée au propriétaire, même
// raisonnement que pour "messages" (vider sa propre messagerie lors de
// la suppression de compte, account.html).
// ------------------------------------------------------------
match /users/{uid}/advisorRequests/{requestId} {
// AUDIT SÉCURITÉ 2026-09-02 : le conseiller est une exclusivité
// Signature/Signature Focus (flag "advisor", js/plan-features.js) —
// désormais aussi côté serveur (isSignaturePlan/isTester).
allow create: if isOwner(uid) &&
(isSignaturePlan(uid) || isDossierConseiller(uid) || isTester(uid)) &&
request.resource.data.keys().hasOnly(["text", "applicationId", "university", "status", "createdAt"]) &&
request.resource.data.text is string && request.resource.data.text != "" &&
request.resource.data.status == "nouveau";
allow read: if isOwner(uid) || isAdmin();
allow update: if isAdmin();
allow delete: if isOwner(uid);
}

// ------------------------------------------------------------
// Suivi de candidatures (applications.html) — entièrement possédé et
// géré par l'étudiant lui-même, à la différence de adminNotes/messages
// ci-dessus. Un admin peut lire à des fins de support mais n'écrit
// jamais dedans, à UNE exception près : le champ "checklist" (lettres
// de recommandation, test de langue, preuve financière — voir
// applications.js). Une lettre de recommandation arrive par un canal
// externe (e-mail) qu'aucun backend ne surveille encore ; l'admin doit
// pouvoir la marquer "reçue" à la place de l'étudiant si besoin (voir
// admin/student-detail.js). Tout le reste du document (status,
// deadline, notes...) reste strictement réservé à l'étudiant.
// ------------------------------------------------------------
// CRÉNEAUX ANTI-TRICHE (audit sécurité 2026-09-02). Les règles ne
// savent pas COMPTER une sous-collection — elles contraignent donc
// l'IDENTIFIANT : toute nouvelle candidature doit s'appeler "slot-N"
// avec N dans le motif autorisé par la formule (slotPattern
// ci-dessus). Il ne peut mécaniquement pas exister plus de
// candidatures SIMULTANÉES créées que de créneaux ; supprimer une
// candidature libère son créneau — c'est la promesse commerciale
// (« N à la fois »). Côté client, js/application-actions.js
// (slotIdLibre) choisit le premier créneau libre ; addDoc (id auto)
// est désormais REFUSÉ ici. Les documents à id auto créés AVANT
// cette règle restent lisibles, modifiables et supprimables — seule
// la CRÉATION est contrainte.
// ------------------------------------------------------------
// LA PREUVE DE DÉPÔT (lot E1, 2026-09-07) — miroir de js/preuve-depot.js.
// Un statut DÉPOSÉ (deposee, en_attente, reponse_recue, admise,
// refusee, liste_attente) ne s'écrit qu'avec une preuveDepot valide :
// mode dans le vocabulaire, champ requis selon le mode, deposeLe au
// format date, fichier (s'il y en a un) dans le dossier Storage de
// CETTE candidature. Une déclaration structurée, pas une vérification.
// JAMAIS DE DÉGRADATION : la règle ne joue qu'à la TRANSITION vers un
// statut déposé (le champ « status » figure dans affectedKeys) — une
// candidature déjà déposée sans preuve reste modifiable sur ses
// autres champs. Même style que les créneaux slot-N.
// ------------------------------------------------------------
function estStatutDepose(statut) {
return statut in ['deposee', 'en_attente', 'reponse_recue', 'admise', 'refusee', 'liste_attente'];
}

function preuveValide(d, uid, applicationId) {
return d.keys().hasAll(['preuveDepot']) &&
d.preuveDepot is map &&
d.preuveDepot.keys().hasOnly(['mode', 'numeroDossier', 'fichier', 'deposeLe', 'declareLe']) &&
d.preuveDepot.get('mode', '') in ['numero', 'capture', 'transmis'] &&
d.preuveDepot.get('deposeLe', '') is string &&
d.preuveDepot.get('deposeLe', '').matches('[0-9]{4}-[0-9]{2}-[0-9]{2}') &&
(!('numeroDossier' in d.preuveDepot) || (d.preuveDepot.numeroDossier is string && d.preuveDepot.numeroDossier.size() <= 64)) &&
(!('fichier' in d.preuveDepot) || (d.preuveDepot.fichier is string && d.preuveDepot.fichier.matches('users/' + uid + '/applications/' + applicationId + '/.*'))) &&
(
(d.preuveDepot.mode == 'numero' && d.preuveDepot.get('numeroDossier', '') != '') ||
(d.preuveDepot.mode == 'capture' && d.preuveDepot.get('fichier', '') != '') ||
(d.preuveDepot.mode == 'transmis' && (d.preuveDepot.get('numeroDossier', '') != '' || d.preuveDepot.get('fichier', '') != ''))
);
}

// Vrai si cette écriture ne pose PAS un statut déposé sans preuve :
// soit le statut n'est pas déposé, soit il n'a pas bougé (pas de
// dégradation d'une candidature ancienne), soit la preuve est valide.
function depotJustifie(uid, applicationId, transition) {
return !estStatutDepose(request.resource.data.get('status', '')) ||
!transition ||
preuveValide(request.resource.data, uid, applicationId);
}

// ------------------------------------------------------------
// LOT FITZ-CHOISIT (2026-09-11) — c'est Fitz qui choisit.
// Pour une candidature du parcours BOURSES (track != preinscription),
// l'identité (université, bourse, programme, portail, site) doit
// venir du CATALOGUE : un programId qui existe dans /programs, avec
// un scholarshipId et un universityId cohérents avec ce programme,
// et — quand le nom est écrit — le nom de l'université du catalogue.
// C'est ce qui interdit le texte libre tout en autorisant le
// remplacement par Fitz.
//
// Jamais de dégradation : une candidature ancienne sans programId
// reste modifiable sur ses autres champs (statut, notes, preuve…) ;
// seule une écriture qui TOUCHE l'identité exige la cohérence. Les
// vœux pre-N (préinscription) et les droits de l'admin sont inchangés.
//
// RISQUE RÉSIDUEL, ACCEPTÉ : un étudiant très technique pourrait,
// depuis la console, viser un AUTRE programme DU CATALOGUE. Il ne
// pourra jamais viser une université hors catalogue. Les règles ne
// savent pas refaire le calcul de Fitz : on n'essaie pas.
// ------------------------------------------------------------
function champsIdentite() {
return ["university", "scholarship", "scholarshipId", "programId", "universityId", "portalUrl", "universityWebsite"];
}

function estBourse(d) {
return d.get('track', 'bourse') != 'preinscription';
}

function programmeDe(d) {
return get(/databases/$(database)/documents/programs/$(d.programId)).data;
}

// L'identité de la candidature est celle d'un programme du catalogue.
// `nomExige` : vrai quand le nom de l'université doit lui aussi être
// celui du catalogue (création, ou modification du nom).
function identiteCatalogue(d, nomExige) {
return d.get('programId', null) is string &&
exists(/databases/$(database)/documents/programs/$(d.programId)) &&
d.get('scholarshipId', null) == programmeDe(d).get('scholarshipId', null) &&
(!('universityId' in d) || d.universityId == null || d.universityId == programmeDe(d).universityId) &&
(!nomExige || d.get('university', '') == get(/databases/$(database)/documents/universities/$(programmeDe(d).universityId)).data.get('name', ''));
}

match /users/{uid}/applications/{applicationId} {
allow read: if isOwner(uid) || isAdmin();
// Grille B : le quota se lit PAR PARCOURS (request.resource.data.track,
// « bourse » par défaut — règle des trois valeurs de js/parcours.js) :
// une préinscription vit sur "pre-N", une bourse sur "slot-N".
allow create: if isOwner(uid) && (
(request.resource.data.get('track', 'bourse') == 'preinscription' && applicationId.matches(preSlotPattern(uid))) ||
(request.resource.data.get('track', 'bourse') != 'preinscription' && applicationId.matches(slotPattern(uid)))
) && depotJustifie(uid, applicationId, true)
// FITZ-CHOISIT : une bourse naît du catalogue, jamais du clavier.
&& (!estBourse(request.resource.data) || identiteCatalogue(request.resource.data, true));
allow delete: if isOwner(uid);
// E1 : la transition vers un statut déposé exige la preuve ; une
// preuve écrite (même sans changer le statut) doit être bien formée.
allow update: if (isOwner(uid) &&
depotJustifie(uid, applicationId, 'status' in request.resource.data.diff(resource.data).affectedKeys()) &&
(!('preuveDepot' in request.resource.data.diff(resource.data).affectedKeys()) || !('preuveDepot' in request.resource.data) || preuveValide(request.resource.data, uid, applicationId)) &&
// FITZ-CHOISIT : toucher l'identité d'une bourse exige la cohérence
// catalogue ; le nom, s'il change, est celui du catalogue.
(!estBourse(request.resource.data) ||
!request.resource.data.diff(resource.data).affectedKeys().hasAny(champsIdentite()) ||
identiteCatalogue(request.resource.data, 'university' in request.resource.data.diff(resource.data).affectedKeys()))) ||
(isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["checklist", "updatedAt"]));
}

// ------------------------------------------------------------
// SIGNALER UN PROBLÈME (grille A, 2026-09-07) — service après-vente,
// ouvert à TOUTE formule payante (Pass Découverte et offres
// préinscription compris), jamais au gratuit. Voie SÉPARÉE de la
// messagerie : un problème technique, un paiement, une erreur du
// site — pas une question de dossier. L'étudiant crée son signalement
// avec une forme imposée (status "nouveau", texte non vide) ; seul un
// administrateur le lit et le fait évoluer (admin/messages.html).
// Lecture par l'étudiant : uniquement ses propres signalements.
// ------------------------------------------------------------
match /supportTickets/{ticketId} {
allow create: if isSignedIn() &&
request.resource.data.uid == request.auth.uid &&
(isPaidPlan(request.auth.uid) || hasPreinscription(request.auth.uid) || hasFitzExpressPass(request.auth.uid) || isTester(request.auth.uid)) &&
request.resource.data.keys().hasOnly(["uid", "email", "name", "sujet", "texte", "page", "status", "createdAt"]) &&
request.resource.data.sujet in ["paiement", "technique", "site"] &&
request.resource.data.texte is string && request.resource.data.texte != "" &&
request.resource.data.status == "nouveau";
allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "traiteLe"]);
allow delete: if isAdmin();
}

// ------------------------------------------------------------
// LE JOURNAL DES BLOCAGES (lot FITZ-RECOURS, 2026-09-10).
// À chaque ouverture de Fitz depuis un blocage, l'étudiant écrit UN
// document : le code du blocage et son issue — jamais un texte de
// conversation, jamais une donnée personnelle. La forme est imposée
// ici (hasOnly) : un champ de plus est refusé. L'administrateur lit
// l'ensemble (collectionGroup) pour compter les blocages fréquents :
// c'est ce journal qui dira sur quoi entraîner l'IA.
// ------------------------------------------------------------
match /users/{uid}/blocages/{blocageId} {
allow create: if isOwner(uid) &&
request.resource.data.keys().hasOnly(["code", "applicationId", "etapeId", "parcours", "plan", "resolu", "date"]) &&
request.resource.data.code is string && request.resource.data.code.size() > 0 && request.resource.data.code.size() <= 32 &&
request.resource.data.parcours in ["bourse", "preinscription"] &&
request.resource.data.resolu is bool;
allow read: if isOwner(uid) || isAdmin();
allow update, delete: if false;
}

match /{path=**}/blocages/{blocageId} {
allow read: if isAdmin();
}

// ------------------------------------------------------------
// Catalogue public (lu par tous les visiteurs, y compris non
// connectés, depuis scholarships.js/universities-page.js/details.js).
// Seuls les administrateurs déclarés peuvent le modifier.
//
// Architecture relationnelle (2026-07-30, remplace le champ texte
// libre "university" sur les bourses) : "scholarships" et
// "universities" sont chacune des fiches uniques (jamais dupliquées
// par université ni par niveau) ; "programs" est la vraie relation
// many-to-many entre les deux, une fiche par offre réelle
// (université × bourse × niveau), avec ses données propres (deadline,
// portail, langue). "universities" garde temporairement son ancien
// sens (une fiche par offre) le temps de la migration vers "programs"
// — les deux collections restent lisibles/écrivables selon le même
// motif jusqu'à confirmation que "programs" est fiable.
// ------------------------------------------------------------
match /scholarships/{scholarshipId} {
allow read: if true;
allow write: if isAdmin();
}

match /universities/{universityId} {
allow read: if true;
allow write: if isAdmin();
}

// "programs" est la relation many-to-many (voir commentaire
// ci-dessus) : chaque document DOIT toujours pointer vers une vraie
// université (universityId, chaîne non vide). scholarshipId peut
// être `null` temporairement — cas d'un document migré depuis
// l'ancien modèle sans bourse reconnue (voir admin/migrate.js, liste
// des "orphelins"), à rattacher manuellement depuis l'admin plutôt
// que perdu silencieusement pendant la migration. Ce n'est pas une
// protection contre un acteur malveillant (seul un admin, déjà
// pleinement authentifié, peut écrire ici) mais une garde-fou contre
// une erreur d'interface admin qui écrirait un document sans lien
// exploitable vers une université.
function isValidProgram() {
return request.resource.data.keys().hasAll(["universityId", "scholarshipId"]) &&
request.resource.data.universityId is string &&
request.resource.data.universityId != "" &&
(request.resource.data.scholarshipId is string || request.resource.data.scholarshipId == null);
}

match /programs/{programId} {
allow read: if true;
allow create, update: if isAdmin() && isValidProgram();
allow delete: if isAdmin();
}

// "universities_draft" est la collection de transit utilisée par
// admin/migrate.js (étape 2 "Écrire") pour préparer les profils
// d'université propres AVANT de basculer "universities" (étape 3
// "Finaliser") — jamais lue par le site public ni par le panneau
// admin en usage normal, seulement par l'outil de migration lui-même.
// OUBLIÉE lors de la première version de ces règles : le SDK
// n'écrivait alors dans aucune règle explicite, donc tombait sur le
// refus général tout en bas de ce fichier ("permission-denied" sur
// l'écriture de universities_draft, cause exacte de l'échec de
// l'étape 2 du 2026-07-30). Même motif que "universities"/
// "scholarships" — cohérent avec le reste du catalogue.
match /universities_draft/{draftId} {
allow read: if isAdmin();
allow write: if isAdmin();
}

// ------------------------------------------------------------
// Statut administrateur : lisible uniquement par l'intéressé
// (pour permettre la vérification côté client dans
// admin/admin-auth.js), jamais inscriptible par un client.
// Un nouvel administrateur ne peut être créé que depuis la
// console Firebase ou un futur outil serveur de confiance.
// ------------------------------------------------------------
// ------------------------------------------------------------
// LES ADMINISTRATEURS (lot ADMIN, 2026-09-09)
//
// `allow write: if false` obligeait à passer par la console Firebase
// pour nommer qui que ce soit. Le propriétaire peut désormais déléguer
// depuis l'interface — sans jamais créer de compte : on PROMEUT un
// compte existant, qui s'est inscrit normalement. Aucun mot de passe ne
// transite nulle part.
//
// Quatre garde-fous, et ils tiennent ensemble :
//   1. seul un superAdmin écrit ici ;
//   2. le document écrit porte OBLIGATOIREMENT role:"admin" — on ne
//      peut donc pas se fabriquer un pair, ni un successeur ;
//   3. on ne modifie QUE le document d'un administrateur ordinaire
//      (`resource.data.get("role", "superAdmin")`) : le document du
//      propriétaire, qui n'a pas de rôle, est intouchable depuis le
//      client — c'est ce qui rend l'amorçage sûr ;
//   4. la SUPPRESSION est interdite à tout le monde. On ne supprime pas
//      un administrateur, on le désactive : l'historique de qui a été
//      nommé, par qui et quand, ne doit pas pouvoir disparaître.
//
// La lecture s'ouvre au superAdmin : la page administrateurs.html liste
// la collection, et un `list` passe par la même règle qu'un `get`.
// ------------------------------------------------------------
match /admins/{uid} {

allow read: if isOwner(uid) || isSuperAdmin();

allow create: if isSuperAdmin()
&& request.resource.data.role == "admin"
&& request.resource.data.keys().hasOnly(["role", "isActive", "nommeLe", "nommePar", "email", "nom"]);

allow update: if isSuperAdmin()
&& request.auth.uid != uid
&& resource.data.get("role", "superAdmin") == "admin"
&& request.resource.data.role == "admin"
&& request.resource.data.keys().hasOnly(["role", "isActive", "nommeLe", "nommePar", "email", "nom"]);

allow delete: if false;

}

// ------------------------------------------------------------
// Suivi d'événements (js/analytics.js), fondation du futur
// Fitz Control Center admin. Écrit directement depuis le
// client tant qu'aucun Cloud Function n'existe :
//  - analyticsEvents est un journal brut, append-only : la création
//    est ouverte (une vue de bourse/université peut survenir avant
//    inscription, donc sans compte), mais aucune modification ni
//    suppression n'est permise depuis un client. Lecture réservée
//    aux administrateurs (c'est le futur journal d'audit).
//  - les collections analytics*Counters contiennent des compteurs
//    agrégés (increment()) lus par le Control Center — une collection
//    de premier niveau par dimension (totals/jour/formule/pays/
//    université/domaine), plutôt que des sous-chemins, car un chemin
//    Firestore doit avoir un nombre pair de segments pour désigner
//    un document. Limite connue et acceptée pour l'instant : ces
//    règles ne peuvent pas garantir qu'une écriture n'incrémente que
//    de 1 — un client malveillant pourrait fausser un chiffre. À
//    corriger quand l'agrégation passera côté serveur (trigger
//    Firestore) : ce jour-là, remplacer par write: if false. Lecture
//    réservée aux administrateurs (statistiques internes).
// ------------------------------------------------------------
match /analyticsEvents/{eventId} {
allow create: if true;
allow read, update, delete: if isAdmin();
}

match /analyticsCounters/{document} {
allow read: if isAdmin();
allow write: if true;
}

match /analyticsDailyCounters/{document} {
allow read: if isAdmin();
allow write: if true;
}

match /analyticsPlanCounters/{document} {
allow read: if isAdmin();
allow write: if true;
}

match /analyticsCountryCounters/{document} {
allow read: if isAdmin();
allow write: if true;
}

match /analyticsUniversityCounters/{document} {
allow read: if isAdmin();
allow write: if true;
}

match /analyticsFieldCounters/{document} {
allow read: if isAdmin();
allow write: if true;
}

// ------------------------------------------------------------
// Configuration pilotable depuis l'administration (Module 4 —
// Gestion des formules, js/plan-features.js). config/planFeatures
// contient quelles fonctionnalités sont activées pour chaque
// formule : lu par chaque étudiant connecté (dashboard.js en a
// besoin pour savoir quoi verrouiller), modifiable uniquement par
// un administrateur (admin/plans.js). Si ce document n'existe pas
// ou n'est pas accessible, js/plan-features.js retombe sur des
// valeurs par défaut identiques au verrouillage codé en dur
// d'origine — aucune régression possible.
// ------------------------------------------------------------
match /config/{configId} {
allow read: if isSignedIn();
allow write: if isAdmin();
}

// Par défaut, tout le reste est refusé.
match /{document=**} {
allow read, write: if false;
}

}
}

{
  "name": "fitzuniverse",
  "version": "0.2.0",
  "private": true,
  "description": "FitzUniverse - plateforme d'orientation vers les bourses et universites internationales.",
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "emulators": "firebase emulators:start --project scholarbridge-e0d84 --only auth,firestore,storage",
    "seed:emulator": "cross-env FIRESTORE_EMULATOR_HOST=localhost:8080 FIREBASE_AUTH_EMULATOR_HOST=localhost:9099 node scripts/seed-emulator.mjs",
    "verifier": "node scripts/verifier/verifier.mjs",
    "radar": "node scripts/radar-echeances.mjs",
    "completude": "node scripts/completude.mjs"
  },
  "dependencies": {
    "firebase": "^12.16.0"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "firebase-admin": "^14.2.0",
    "firebase-tools": "^15.26.0",
    "lucide": "^1.31.0",
    "playwright": "^1.56.1",
    "sharp": "^0.35.4"
  }
}
